---
import Layout from '../layouts/Layout.astro';
import '../styles/jewellery.css';
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

import bands1 from '../assets/jewellery/bands1.jpeg';
import bands2 from '../assets/jewellery/bands2.jpeg';
import earringsCoral from '../assets/jewellery/earrings-coral.jpg';
import earringsSeaglass from '../assets/jewellery/earrings-seaglass.jpg';
import braceletWorn from '../assets/jewellery/bracelet-wrap-worn.jpg';

// Curated, ordered — an explicit list rather than a glob, so adding a photo to the
// folder never silently changes the page (and mixed .jpeg/.jpg can't bite us).
// `pos` is the object-position for the 4:5 card crop, tuned per photo.
const pieces = [
  {
    src: bands2,
    title: 'Woven bands',
    note: 'Loom-woven seed beads, finished with a clasp and extension chain',
    alt: 'Four loom-woven seed-bead bands in green, coral, blue and yellow',
    pos: 'center',
  },
  {
    src: earringsCoral,
    title: 'Drop earrings — coral',
    note: 'Hand-strung glass, three linked drops',
    alt: 'A pair of coral and peach glass drop earrings',
    pos: 'center 38%',
  },
  {
    src: earringsSeaglass,
    title: 'Drop earrings — sea glass',
    note: 'Hand-strung glass and shell on a silver-plated hook',
    alt: 'A pair of green glass and shell drop earrings',
    pos: 'center 34%',
  },
  {
    src: braceletWorn,
    title: 'Wrap bracelet',
    note: 'Memory-wire coil, mixed glass beads — fits any wrist',
    alt: 'A turquoise beaded wrap bracelet worn on a wrist',
    pos: 'center 42%',
  },
];

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/paintings/*.{jpeg,jpg}', { eager: true });
const heroUrl = (await getImage({ src: files['../assets/paintings/11.jpeg'].default, width: 1920, format: 'webp', quality: 80 })).src;
const bandBgUrl = (await getImage({ src: files['../assets/paintings/21.jpeg'].default, width: 1920, format: 'webp', quality: 80 })).src;
---
<Layout
  nav="page"
  title="Jewellery | Anna's Art Studio"
  description="Handmade beaded jewellery by Anna Goldmeier — loom-woven bands, drop earrings, and wrap bracelets, made to order in your colours."
>
  <div class="jw-top" style={`background-image:url('${heroUrl}')`}>
  <section class="page-hero">
    <div class="page-hero-inner">
      <h1>Jewellery</h1>
      <p>Handmade beaded pieces — woven, strung, and made to order in your colours.</p>
    </div>
  </section>

  <section class="jw-frame">
    <div class="jw-frame-inner canvas-texture">
      <div class="jw-intro">
        <span class="about-title">
          <h2>Made by hand, <em>one at a time</em></h2>
          <span class="brush-u">
            <svg viewBox="0 0 300 34" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <defs>
                <filter id="brj" x="-4%" y="-60%" width="108%" height="220%">
                  <feTurbulence type="fractalNoise" baseFrequency="0.7 0.12" numOctaves="2" seed="11" result="n"/>
                  <feDisplacementMap in="SourceGraphic" in2="n" scale="4.5"/>
                </filter>
                <filter id="brjdry">
                  <feTurbulence type="fractalNoise" baseFrequency="0.01 0.55" numOctaves="2" seed="13" result="t"/>
                  <feComponentTransfer in="t"><feFuncA type="linear" slope="0.55" intercept="0.62"/></feComponentTransfer>
                </filter>
                <mask id="brjmask">
                  <rect width="300" height="34" fill="#fff"/>
                  <rect width="300" height="34" fill="#000" filter="url(#brjdry)"/>
                </mask>
              </defs>
              <path filter="url(#brj)" mask="url(#brjmask)" fill="currentColor"
                d="M4 18 C 70 9 140 8 168 11 C 226 16 268 12 297 16 C 270 25 210 27 150 24 C 95 22 48 26 4 18 Z"/>
            </svg>
          </span>
        </span>
        <p>Alongside the paintings I make beaded jewellery — the same feeling for colour, worked at a much smaller scale. Every piece is made by hand, so no two come out quite the same.</p>
        <p>The pieces below are examples rather than a fixed range. Most things can be made again in your own colours, sized to fit, and I'm always happy to work from an idea you bring me.</p>
      </div>
    </div>
  </section>
  </div>

  <main class="jw-body canvas-texture">
    <section class="jw-band" style={`background-image:url('${bandBgUrl}')`}>
    <div class="jw-frame-inner canvas-texture">
      <div class="jw-section">
        <div class="jw-section-head">
          <span class="about-title">
            <h2>Woven bands</h2>
            <span class="brush-u">
              <svg viewBox="0 0 300 34" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <defs>
                  <filter id="brw" x="-4%" y="-60%" width="108%" height="220%">
                    <feTurbulence type="fractalNoise" baseFrequency="0.7 0.12" numOctaves="2" seed="17" result="n"/>
                    <feDisplacementMap in="SourceGraphic" in2="n" scale="4.5"/>
                  </filter>
                  <filter id="brwdry">
                    <feTurbulence type="fractalNoise" baseFrequency="0.01 0.55" numOctaves="2" seed="19" result="t"/>
                    <feComponentTransfer in="t"><feFuncA type="linear" slope="0.55" intercept="0.62"/></feComponentTransfer>
                  </filter>
                  <mask id="brwmask">
                    <rect width="300" height="34" fill="#fff"/>
                    <rect width="300" height="34" fill="#000" filter="url(#brwdry)"/>
                  </mask>
                </defs>
                <path filter="url(#brw)" mask="url(#brwmask)" fill="currentColor"
                  d="M4 18 C 70 9 140 8 168 11 C 226 16 268 12 297 16 C 270 25 210 27 150 24 C 95 22 48 26 4 18 Z"/>
              </svg>
            </span>
          </span>
        </div>

        <p class="jw-section-lead">Each band is woven bead by bead on a loom, so the pattern is planned before a single bead goes on. They fasten with a clasp and an extension chain, and can be woven to any length.</p>

        <figure class="jw-feature">
          <Image src={bands1} alt="Six loom-woven seed-bead bands in blush, pearl, silver and dusty purple" widths={[700, 1100, 1600]} sizes="(max-width: 820px) 92vw, 1000px" />
          <figcaption>Woven bands in blush, pearl and silver — one of a set made to order</figcaption>
        </figure>
      </div>
    </div>
    </section>

    <section class="jw-pieces">
      <div class="jw-section">
        <div class="jw-section-head">
          <span class="about-title">
            <h2>Recent pieces</h2>
            <span class="brush-u">
              <svg viewBox="0 0 300 34" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <defs>
                  <filter id="brr" x="-4%" y="-60%" width="108%" height="220%">
                    <feTurbulence type="fractalNoise" baseFrequency="0.7 0.12" numOctaves="2" seed="23" result="n"/>
                    <feDisplacementMap in="SourceGraphic" in2="n" scale="4.5"/>
                  </filter>
                  <filter id="brrdry">
                    <feTurbulence type="fractalNoise" baseFrequency="0.01 0.55" numOctaves="2" seed="29" result="t"/>
                    <feComponentTransfer in="t"><feFuncA type="linear" slope="0.55" intercept="0.62"/></feComponentTransfer>
                  </filter>
                  <mask id="brrmask">
                    <rect width="300" height="34" fill="#fff"/>
                    <rect width="300" height="34" fill="#000" filter="url(#brrdry)"/>
                  </mask>
                </defs>
                <path filter="url(#brr)" mask="url(#brrmask)" fill="currentColor"
                  d="M4 18 C 70 9 140 8 168 11 C 226 16 268 12 297 16 C 270 25 210 27 150 24 C 95 22 48 26 4 18 Z"/>
              </svg>
            </span>
          </span>
        </div>

        <div class="jw-grid">
          {pieces.map((p) => (
            <figure class="jw-card">
              <div class="jw-card-img">
                <Image src={p.src} alt={p.alt} widths={[400, 800]} sizes="(max-width: 820px) 92vw, 480px" style={`object-position:${p.pos}`} />
              </div>
              <figcaption>
                <span class="t">{p.title}</span>
                <span class="n">{p.note}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section class="jw-cta">
      <h2>Something in your colours?</h2>
      <p>Tell me what you have in mind — a colour, an occasion, or a piece from above you'd like remade — and I'll let you know what's possible.</p>
      <div class="jw-cta-row">
        <a class="jw-btn" href="/contact">Enquire about a piece</a>
        <a class="jw-btn ghost" href="https://wa.me/447910262259">Message on WhatsApp</a>
      </div>
    </section>
  </main>
</Layout>
