---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
// handwritten wordmark — traced vector, fill="currentColor" so it follows the
// nav's white↔ink colour states like the text it replaces
import wordmark from '../assets/wordmark.svg?raw';
const {
  nav = "hero",   // "hero" | "page" | "solid"
  footer = "solid",   // "solid" | "transparent" (transparent also darkens the page base)
  title = "Anna's Art Studio",
  description = "Original paintings, fine-art prints, handcrafted jewellery, and creative events by Anna Goldmeier — rooted in nature, emotion, and vibrant colour.",
  image = "/OG.jpeg",   // social share image (override per page); add public/og.jpeg
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.jpeg" />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Anna's Art Studio" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Anna Goldmeier",
      "jobTitle": "Artist",
      "url": Astro.site?.toString(),
      "description": description,
    })} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..600;1,9..144,300..500&family=Inter:wght@300;400;500&family=Source+Serif+4:opsz,wght@8..60,300..500&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <ClientRouter />
</head>

<body data-nav={nav} data-footer={footer}>
    <!-- Header  -->
    <nav class:list={["nav", { scrolled: nav === "solid" }]}>
        <a class="brand" href="/" aria-label="Anna's Art Studio — home"><Fragment set:html={wordmark} /></a>
        <div class="links"><a href="/">Home</a><a href="/gallery">Gallery</a><a href="/private-events">Private Events</a><a href="/contact">Contact</a></div>
        <button class="burger" aria-label="Open menu" aria-expanded="false">
            <svg viewBox="0 0 30 30" fill="none" stroke="currentColor" stroke-linecap="round" aria-hidden="true">
                <filter id="navbr" x="-20%" y="-20%" width="140%" height="140%">
                    <feTurbulence type="fractalNoise" baseFrequency="0.18 0.32" numOctaves="2" seed="5" result="n"/>
                    <feDisplacementMap in="SourceGraphic" in2="n" scale="1.4"/>
                </filter>
                <g filter="url(#navbr)" stroke-width="2.5">
                    <path d="M4 8.4 Q 14.5 7.1 26 8.1"/>
                    <path d="M4.2 15.6 Q 14.8 15 25.6 15.5"/>
                    <path d="M4.4 22.3 Q 15 23.1 25.8 22.1"/>
                </g>
            </svg>
        </button>
    </nav>

    <!-- Phone menu modal -->
    <div class="menu" id="menu" inert>
        <button class="close" aria-label="Close menu">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
        <nav class="menu-links">
            <a href="/">Home</a>
            <a href="/gallery">Gallery</a>
            <a href="/private-events">Private Events</a>
            <a href="/contact">Contact</a>
        </nav>
    </div>

    <!-- Main content slot  -->
    <slot />

    <!-- Footer -->
    <footer class="site-footer">
        <div class="foot-left">
            <span class="foot-mark">Anna's Art Studio</span>
            <span class="foot-copy">© 2026</span>
        </div>
        <div class="foot-right">
            <a class="foot-btn" href="/gallery">Gallery</a>
            <a class="foot-btn solid" href="/contact">Contact</a>
            <a class="to-top" href="#top">Back to top ↑</a>
        </div>
    </footer>

    <script>

        // --- nav: 'hero' (homepage) fades transparent→solid; 'page' (content) auto-hides down / reveals up ---
        let lastY = window.scrollY;
        let upAmount = 0;                             // accumulated up-scroll, so a jitter doesn't pop the nav
        const REVEAL_AT = 50;                         // px of deliberate up-scroll before revealing
        const NEAR_TOP = 200;                         // this close to the top, skip the fixed reveal — the in-flow bar arrives anyway
        const updateNav = () => {
            const nav = document.querySelector('.nav') as HTMLElement | null;
            if (!nav) return;
            const mode = document.body.dataset.nav;
            const y = window.scrollY;
            if (mode === 'hero') {
                nav.classList.toggle('scrolled', y > window.innerHeight * 0.7);
            } else if (mode === 'page') {
                if (y <= 10) {                                             // at top → transparent, in-flow
                    nav.classList.remove('scrolled', 'nav-hidden'); upAmount = 0;
                } else if (y > lastY) {                                    // scrolling down
                    upAmount = 0;
                    // only slide-hide the revealed (fixed) bar; the transparent in-flow bar just scrolls away
                    if (nav.classList.contains('scrolled')) nav.classList.add('nav-hidden');
                } else if (y < lastY) {                                    // scrolling up
                    upAmount += lastY - y;
                    if (upAmount > REVEAL_AT && y > NEAR_TOP) {
                        if (nav.classList.contains('scrolled')) {
                            nav.classList.remove('nav-hidden');            // already fixed → slide back down
                        } else {
                            // first reveal from the in-flow bar: pin it off-screen with no transition, then slide in
                            nav.style.transition = 'none';
                            nav.classList.add('scrolled', 'nav-hidden');
                            void nav.offsetHeight;                       // flush — bar is now truly at -100%
                            nav.style.transition = '';                   // restore the stylesheet transition
                            nav.classList.remove('nav-hidden');
                        }
                    }
                }
            }
            lastY = y;
        };

        // --- global listeners: registered ONCE for the whole session ---
        window.addEventListener('scroll', () => { updateNav(); }, { passive: true });

        document.addEventListener('keydown', (e) => {
            if (e.key !== 'Escape') return;
            const menu = document.getElementById('menu');
            if (menu && menu.classList.contains('open')) {
                menu.classList.remove('open');
                document.body.classList.remove('menu-open');
                menu.setAttribute('inert', '');
            }
        });

        // --- per-page setup: runs on first load AND after every view transition ---
        document.addEventListener('astro:page-load', () => {
            // nav initial state for this page (never hidden on load)
            lastY = window.scrollY;
            upAmount = 0;
            const nav = document.querySelector('.nav');
            if (nav) {
                const mode = document.body.dataset.nav;
                nav.classList.remove('nav-hidden');
                if (mode === 'hero') nav.classList.toggle('scrolled', window.scrollY > window.innerHeight * 0.7);
                else if (mode === 'page') nav.classList.toggle('scrolled', window.scrollY > 10);
            }
            // mobile menu (elements are fresh after each navigation → no stacking)
            const burger = document.querySelector('.burger');
            const menu = document.getElementById('menu');
            if (burger && menu) {
                const setMenu = (open: boolean) => {
                    menu.classList.toggle('open', open);
                    document.body.classList.toggle('menu-open', open);
                    menu.toggleAttribute('inert', !open);
                    burger.setAttribute('aria-expanded', String(open));
                };
                burger.addEventListener('click', () => setMenu(true));
                menu.addEventListener('click', (e) => {
                    // nav-link tap → leave the overlay open while the router
                    // loads; the view transition dissolves it into the new page
                    if (!(e.target as Element).closest('a')) setMenu(false);
                });
            }
        });
    </script>
</body>
</html>